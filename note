

let
    Name = [#"Standardize physician Name"],
    CleanName = if Name = null then "" else Text.Upper(Text.Trim(Name)),
    Words = Text.SplitAny(CleanName, " ,.;()"),
    Credentials = {"MD", "DO", "NP", "APRN", "CNP", "FNP", "PA", "DNP", "APRN-CNP", "PA-C", "FNP-C", "DR"},
    Filtered = List.Select(Words, each Text.Length(_) > 1 and not List.Contains(Credentials, _)),
    Sorted = List.Sort(Filtered),
    MatchKey = Text.Combine(Sorted, " ")
in
    MatchKey





Text.Combine(
    List.Distinct(
        List.RemoveNulls(
            [#"Original records"][Referring Physician]
        )
    ),
    " | "
)




